{
  "name": "ledger-strategist",
  "version": "0.1.0",
  "private": true,
  "description": "Ledger + Strategist: multi-entity bookkeeping, reporting, and tax strategy engine",
  "scripts": {
    "setup": "npm install && prisma generate && prisma db push && tsx prisma/seed.ts",
    "start": "next dev -p 4545",
