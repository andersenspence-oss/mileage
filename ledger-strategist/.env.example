# ============================================================
# Ledger + Strategist — configuration
# Copy this file to a new file named  .env  (in this same folder)
# and paste your real keys where indicated. The .env file is
# ignored by git so your secrets never leave your computer.
# ============================================================

# --- Database (leave as-is) ---------------------------------
DATABASE_URL="file:./data/ledger.db"

# --- App secret ---------------------------------------------
# Used to encrypt QuickBooks tokens stored on your computer.
# Replace with any long random string (40+ characters).
APP_SECRET="change-me-to-a-long-random-string-please"

# --- Anthropic Claude API (for AI features) -----------------
# Get a key at https://console.anthropic.com  ->  API Keys
# The app works without it (AI suggestions fall back to rules),
# but the categorization assistant is much better with it.
ANTHROPIC_API_KEY=""

# --- QuickBooks Online (optional until you connect) ---------
# Create a free developer app at https://developer.intuit.com
# then paste the Client ID and Client Secret here.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
# "sandbox" = safe test company data, "production" = your real books
QBO_ENVIRONMENT="sandbox"
# Leave these as-is unless Intuit changes their URLs
QBO_AUTH_URL="https://appcenter.intuit.com/connect/oauth2"
QBO_TOKEN_URL="https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer"
QBO_API_BASE_SANDBOX="https://sandbox-quickbooks.api.intuit.com"
QBO_API_BASE_PRODUCTION="https://quickbooks.api.intuit.com"
# Must exactly match a Redirect URI saved in your Intuit app settings
QBO_REDIRECT_URI="http://localhost:4545/api/qbo/callback"
